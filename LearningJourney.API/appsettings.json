{

  "ConnectionStrings": {
    "DefaultConnection": "Server=ABDELRAHMANADEL\\SQLEXPRESS;Database=LearningJourney;Trusted_Connection=True;TrustServerCertificate=True",
    "HangfireConnection": "Server=ABDELRAHMANADEL\\SQLEXPRESS;Database=HangfireDb;Trusted_Connection=True;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "ExportSettings": {
    "ExportFolderPath": "C:\\Exports"
  },
  "Caching": {
    "Provider": "Redis"
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "LearningJourneyAPI",
    "Audience": "LearningJourneyClient",
    "ExpirationInMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },

    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ],
    "Properties": {
      "Application": "LearningJourney App",
      "Environment": "Development"
    }
  },
  "AllowedHosts": "*"
}
